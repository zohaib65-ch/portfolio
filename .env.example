# Copy this file to .env (or .env.local) and fill in the values.

# MongoDB connection string (Atlas or local), including the database name.
# e.g. mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/portfolio
MONGODB_URI=

# Signs the admin session cookie. Must be at least 32 characters.
# Generate one with: openssl rand -base64 48
AUTH_SECRET=

# Image uploads. Create a free account at cloudinary.com, then on the dashboard
# click "API Keys" and copy the "API environment variable" line:
#   cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
